# Copy this file to .env and fill in only the integrations you want to use.
# Keep .env private. Do not commit real API keys, tokens, or secrets.

# OpenWeatherMap API key used by GET /api/weather.
WEATHER_API_KEY=

# Google Calendar settings used by GET /api/calendar.
# GOOGLE_CALENDAR_ID is the calendar to read.
# GOOGLE_API_KEY is used for Calendar API key access.
GOOGLE_CALENDAR_ID=
GOOGLE_API_KEY=

# Google Tasks OAuth settings used by GET /api/tasks.
# Use the read-only Tasks scope when creating the refresh token:
# https://www.googleapis.com/auth/tasks.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# OpenAI key used by /api/chat and /api/summary.
OPENAI_API_KEY=

# Optional. Only needed for the legacy /assistant/run endpoint.
OPENAI_ASSISTANT_ID=

# Optional comma-separated browser origins allowed to call the API.
# Default allowed origins are:
# http://localhost:3000, http://127.0.0.1:3000,
# http://localhost:4000, http://127.0.0.1:4000
# Example for a Raspberry Pi kiosk:
# DASHBOARD_ALLOWED_ORIGINS=http://192.168.1.50:4000
DASHBOARD_ALLOWED_ORIGINS=
